#include <iostream>
using namespace std;

int main() {
    int n, itemsSold, profitPerItem, totalProfit = 0;
    
    cout << "Enter number of food items: ";
    cin >> n;
    
    for(int i = 1; i <= n; i++) {
        cout << "Enter items sold for item " << i << ": ";
        cin >> itemsSold;
        cout << "Enter profit per item " << i << ": ";
        cin >> profitPerItem;
        totalProfit += itemsSold * profitPerItem;
    }
    
    cout << "Total Profit = " << totalProfit << endl;
    
    if(totalProfit > 5000) {
        cout << "Great Day" << endl;
    }
    
    return 0;
}
